# copy to .env and fill in — .env stays out of git
VITE_MAPTILER_API_KEY=your-maptiler-key

# Supabase (auth + saved lists) — see src/lib/supabaseClient.js
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Scout SMS (server-only: set these in Vercel → Settings → Environment Variables) ----
# Never prefix these with VITE_ — that would ship them to the browser.
# Bearer token that Gwen / schedules / the Shortcut send to /api/send, /api/scouts, /api/signups.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# ---- Spam protection: Google reCAPTCHA v3 (optional; set BOTH or NEITHER) ----
# Site key is public (ships to the browser). Secret key is server-only (Vercel env var, never VITE_).
# If only the secret is set, every waitlist sign-up is rejected.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
