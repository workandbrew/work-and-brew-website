@import url("https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600&display=swap");

/* Shared Pages CSS */
/* Auth page wrapper — removes dead space */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  background-color: #0F1A2E; /* chocolate page bg */
}

/* Card container */
.auth-card {
  background-color: #1C2E52;
  border: 1px solid #372414;
  border-left: 4px solid #372414;
  border-radius: 16px;
  padding: 48px 40px;
  width: 100%;
  max-width: 440px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

/* "JOIN THE LIST" badge */
.auth-badge {
  background-color: #1C2E52;
  border: 1.5px solid #372414;
  color: #E0D9CF;
  font-size: 11px;
  letter-spacing: 0.12em;
  font-weight: 700;
  padding: 6px 18px;
  border-radius: 999px;
  text-transform: uppercase;
  box-shadow: 0 0 14px rgba(224, 217, 207, 0.1);
}

/* Heading */
.auth-card h1 {
  font-family: 'Playfair Display', serif;
  color: #E0D9CF;
  font-size: 2rem;
  font-weight: 600;
  margin: 0;
  text-align: center;
}

/* Form — stacks fields vertically */
.auth-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Input fields */
.auth-form input {
  width: 100%;
  background-color: rgba(15, 26, 46, 0.5);
  border: 1px solid #372414;
  border-radius: 8px;
  color: #E0D9CF;
  font-family: 'Imbue', serif;
  font-size: 14px;
  padding: 14px 16px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  box-sizing: border-box;
}

.auth-form input::placeholder {
  color: rgba(224, 217, 207, 0.45);
}

.auth-form input:focus {
  border-color: #E0D9CF;
  box-shadow: 0 0 0 1px rgba(224, 217, 207, 0.15);
}

/* Submit button */
.auth-form button {
  width: 100%;
  background: #1C2E52;
  color: #E0D9CF;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 14px;
  border: 1.5px solid #372414;
  border-radius: 999px;
  cursor: pointer;
  margin-top: 4px;
  transition: border-color 0.3s, box-shadow 0.3s, color 0.3s, transform 0.15s;
  outline: none;
  user-select: none;
  box-shadow: 0 0 14px rgba(224, 217, 207, 0.1);
}

.auth-form button:hover {
  border-color: #E0D9CF;
  box-shadow: 0 0 20px rgba(55, 36, 20, 0.35), 0 0 6px rgba(55, 36, 20, 0.2);
  transform: translateY(-1px);
}

.auth-form button:active {
  transform: translateY(0);
  box-shadow: 0 0 10px rgba(224, 217, 207, 0.15);
}

/* "Already have an account?" link */
.auth-login-link {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: #E0D9CF;
  text-align: center;
}

.auth-login-link a {
  color: #E0D9CF;
  text-decoration: none;
  font-weight: 600;
}

.auth-login-link a:hover {
  text-decoration: underline;
}

/* Page Shell */
.page-shell {
  min-height: 100vh;
  background: #0F1A2E;
  color: #E0D9CF;
  padding-top: 80px; /* offset for fixed navbar */
}

.page-content {
  max-width: 760px;
  margin: 0 auto;
  padding: 100px 2rem 4rem;
}

.page-content--centered {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-height: 100vh;
  justify-content: flex-start;
  padding-top: 2rem;
}

.page-badge {
  display: inline-block;
  background: #1C2E52;
  border: 1.5px solid #372414;
  color: #E0D9CF;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.5rem 1.25rem;
  border-radius: 999px;
  margin-bottom: 1.25rem;
  box-shadow: 0 0 14px rgba(224, 217, 207, 0.1);
}

.page-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2.5rem;
  font-weight: 800;
  color: #E0D9CF;
  line-height: 1.2;
  margin: 0 0 1.25rem;
}

.page-body {
  color: #E0D9CF;
  font-size: 1.2rem;
  line-height: 1.75;
  margin-bottom: 1rem;
  max-width: 580px;
}

.page-section-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #2E5482;
  margin: 2rem 0 1rem;
}

/* About intro — wireframe layout: story text left, headline + picture right */
.about-intro {
  padding: 110px 4rem 2rem;
  max-width: 1300px;
  margin: 0 auto;
}

.about-hero {
  display: flex;
  align-items: flex-start;
  gap: 3.5rem;
}

.about-hero-left {
  flex: 1 1 50%;
}

.about-hero-right {
  flex: 1 1 50%;
  min-width: 0;
}

/* big, top and center */
.about-headline {
  text-align: center;
  font-size: clamp(2.6rem, 4.5vw, 3.8rem);
  margin: 0 0 2.75rem;
}

@media (max-width: 900px) {
  .about-hero {
    flex-direction: column;
    gap: 1.5rem;
  }
  .about-hero-left {
    flex: 1;
  }
}

/* About intro two column */
.about-intro-inner {
  display: flex;
  align-items: center;
  gap: 4rem;
}

.about-intro-text {
  flex: 1;
}

.about-intro-image {
  flex: 1;
}

/* Base image style — used for non-hero images */
.about-img {
  width: 100%;
  height: 480px;
  object-fit: cover;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  margin-top: 5rem;
}

/* Hero image modifier — must come AFTER .about-img so it wins */
.about-img--hero {
  width: 100%;
  height: 420px;
  margin-top: 0;
}

/* Team section */
.ed-section {
  width: 100%;
  min-height: 80vh;
  display: flex;
  font-family: "Inter", sans-serif;
  opacity: 0;
  filter: blur(6px);
  transform: translateY(20px);
  transition: opacity 1.4s ease, filter 1.4s ease, transform 1.4s ease;
}

.ed-section.is-visible {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
}

/* Left panel */
.ed-featured {
  flex: 1;
  background: #1C2E52;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 7rem 3rem 4rem;
  position: relative;
  border-right: 1px solid #1C2E52;
  font-family: "Inter", sans-serif;
}

/* CTA Down Arrow */
.about-scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  margin-top: 2.2rem;
  padding-bottom: 0.5rem;
}

.about-scroll-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #E0D9CF;
  padding: 0.4rem 0.85rem;
}

.scroll-arrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: #1C2E52;
  border: 1.5px solid #372414;
  color: #E0D9CF;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.65rem 1.75rem;
  border-radius: 999px;
  cursor: pointer;
  outline: none;
  user-select: none;
  box-shadow: 0 0 14px rgba(224, 217, 207, 0.1);
  transition: border-color 0.3s, box-shadow 0.3s, color 0.3s, transform 0.15s;
  animation: subtleBounce 3s ease-in-out infinite;
}

.scroll-arrow:hover {
  border-color: #E0D9CF;
  box-shadow: 0 0 20px rgba(55, 36, 20, 0.35), 0 0 6px rgba(55, 36, 20, 0.2);
  transform: translateY(-1px);
  animation: subtleBounce 3s ease-in-out infinite;
}

/* Shared hover glow for meet-team button */
.timeline-meet-btn:hover,
.timeline-team-cta-btn:hover {
  border-color: #E0D9CF;
  color: #E0D9CF;
  box-shadow: 0 0 22px rgba(224, 217, 207, 0.45), 0 0 50px rgba(224, 217, 207, 0.18);
  transform: translateY(-2px);
}

@keyframes subtleBounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-8px); }
}

/* Kraft receipt card */
.kraft-receipt {
  background: #E0D9CF;
  background-image: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 24px,
    rgba(0,0,0,0.03) 24px,
    rgba(0,0,0,0.03) 25px
  );
  border-radius: 4px;
  padding: 3rem 2.5rem;
  width: 100%;
  max-width: 500px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}

@keyframes receiptSlideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.kraft-receipt {
  animation: receiptSlideUp 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

.kraft-receipt {
  animation: receiptSlideUp 0.4s ease forwards;
}

/* Receipt header */
.kraft-header {
  text-align: center;
  width: 100%;
}

.kraft-store {
  font-family: "Playfair Display", serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: #372414;
  letter-spacing: 0.08em;
  margin: 0;
}

.kraft-address {
  font-size: 0.7rem;
  color: #372414;
  letter-spacing: 0.06em;
  margin: 0.25rem 0 0;
}

.kraft-order-label {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #372414;
  margin: 0.5rem 0 0.15rem;
}

.kraft-order-num {
  font-family: "Playfair Display", serif;
  font-size: 2rem;
  font-weight: 900;
  color: #372414;
  margin: 0;
  line-height: 1;
}

/* Dashed divider */
.kraft-divider-dashed {
  width: 100%;
  border-top: 1.5px dashed #372414;
}

/* Avatar */
.ed-list-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

.kraft-avatar-wrap {
  display: flex;
  justify-content: center;
  width: 100%;
}

.ed-featured-avatar {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: transparent;
  border: 4px solid #372414;
  box-shadow: 0 0 0 2px rgba(55, 36, 20, 0.22), 0 4px 18px rgba(55, 36, 20, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.ed-featured-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

.ed-featured-fallback {
  font-family: "Playfair Display", serif;
  font-size: 2.5rem;
  font-weight: 700;
  color: #372414;
}

/* Name block */
.kraft-name-block {
  text-align: center;
  width: 100%;
}

.ed-featured-tag {
  display: inline-block;
  background: #1C2E52;
  color: #E0D9CF;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 0.35rem 1rem;
  border-radius: 3px;
  margin-bottom: 0.6rem;
  width: fit-content;
}

.ed-featured-top {
  position: absolute;
  top: 2rem;
  left: 3rem;
  padding: 0.3rem 0.85rem;
  border-radius: 20px;
  margin-bottom: 1.5rem;
}

.ed-featured-name {
  font-family: "Playfair Display", serif;
  font-size: 1.75rem;
  font-weight: 700;
  color: #372414;
  line-height: 1.2;
  margin: 0 0 0.3rem;
  letter-spacing: -0.01em;
}

.ed-featured-role {
  font-size: 0.78rem;
  color: #372414;
  font-weight: 500;
  margin: 0;
  letter-spacing: 0.02em;
}

/* Stats */
.kraft-stats {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.kraft-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.75rem;
  border-bottom: 1px dotted #372414;
  padding-bottom: 0.5rem;
}

.kraft-stat-label {
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #372414;
  white-space: nowrap;
  flex-shrink: 0;
}

.kraft-stat-val {
  color: #372414;
  text-align: right;
  font-weight: 500;
}

/* Receipt footer */
.kraft-footer {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #372414;
  text-align: center;
  margin: 0;
}

/* Right panel */
.ed-list {
  flex: 1;
  padding: 4rem 3rem;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  background: #1C2E52;
  justify-content: space-between;
}

.ed-list-label {
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #E0D9CF;
  margin-bottom: 1.5rem;
  padding-left: 0.5rem;
}

/* List Item */
.ed-list-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 0.75rem;
  background: rgba(28, 46, 82, 0.25);
  border: none;
  border-bottom: 1px solid rgba(224, 217, 207, 0.1);
  border-radius: 10px;
  cursor: pointer;
  text-align: left;
  transition: background 0.2s, box-shadow 0.2s;
  width: 100%;
  flex: 1;
}

.ed-list-item:last-child {
  border-bottom: none;
}

.ed-list-item:hover {
  background: #1C2E52;
  box-shadow: 0 0 20px rgba(224, 217, 207, 0.35);
}

.ed-list-item.is-active {
  background: #1C2E52;
  border-left: 2px solid #E0D9CF;
  padding-left: calc(0.75rem - 2px);
}

/* List Avatar */
.ed-list-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid #372414;
  background: #1C2E52;
  color: #E0D9CF;
  font-family: "Playfair Display", serif;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.ed-list-item.is-active .ed-list-avatar {
  background: #E0D9CF;
  color: #1C2E52;
}

/* Info */
.ed-list-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
  min-width: 0;
}

.ed-list-name {
  font-size: 0.95rem;
  font-weight: 600;
  color: #E0D9CF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ed-list-role {
  font-size: 0.75rem;
  color: #E0D9CF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.kraft-about {
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.kraft-about-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #372414;
}

.kraft-about-text {
  font-size: 0.8rem;
  color: #372414;
  line-height: 1.6;
  text-align: center;
  width: 100%;
}


/* Arrow */
.ed-list-arrow {
  font-size: 0.85rem;
  color: #2E5482;
  transition: color 0.2s, transform 0.2s;
  flex-shrink: 0;
}

.ed-list-item.is-active .ed-list-arrow,
.ed-list-item:hover .ed-list-arrow {
  color: #E0D9CF;
  transform: translateX(3px);
}

/* Timeline */npm install maplibre-gl papaparse

.timeline-section {
  width: 100%;
  padding: 12px 0 90px;
  overflow: hidden;
  position: relative;
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 5vw;
  margin-bottom: 0;
  gap: 1.25rem;
}

.timeline-header::before,
.timeline-header::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(224, 217, 207, 0.65));
}

.timeline-header::after {
  background: linear-gradient(to left, transparent, rgba(224, 217, 207, 0.65));
}

.timeline-header .page-badge {
  background: transparent;
  border: none;
  color: #E0D9CF;
  font-size: 0.72rem;
  letter-spacing: 0.22em;
  padding: 0;
  margin-bottom: 0;
  border-radius: 0;
  white-space: nowrap;
  text-shadow: 0 0 18px rgba(224, 217, 207, 0.4);
}

/* ── New interactive timeline (track + node + detail) ──────────────────────── */

.timeline-track-wrap {
  padding: 0 5vw 2rem;
}

/* The horizontal rail + dots row */
.timeline-track {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  padding: 1rem 1rem 0.5rem;
}

/* Timeline rail — thick prominent bar, dark past → bright present */
.timeline-track::before {
  content: "";
  position: absolute;
  top: calc(2rem - 5px);
  left: calc(4% + 0.5rem);
  right: calc(4% + 0.5rem);
  height: 10px;
  background:
    /* top-edge shimmer for 3D depth */
    linear-gradient(
      to bottom,
      rgba(224, 217, 207, 0.3) 0%,
      rgba(255, 255, 255, 0.08) 30%,
      transparent 55%,
      rgba(0, 0, 0, 0.35) 100%
    ),
    /* solid amber base — equal weight end to end */
    #E0D9CF;
  border-radius: 99px;
  z-index: 0;
  box-shadow:
    0 4px 14px rgba(0, 0, 0, 0.7),
    0 1px 3px rgba(0, 0, 0, 0.8),
    0 0 22px rgba(224, 217, 207, 0.22),
    0 0 50px rgba(224, 217, 207, 0.12);
}

/* Each clickable node */
.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.55rem;
  background: transparent;
  border: none;
  cursor: pointer;
  position: relative;
  z-index: 1;
  padding: 0 0.5rem;
  margin-top: -0.5rem;
  opacity: 0;
  transform: translateY(28px) scale(0.82);
  transition: color 0.2s;
}

.timeline-node.timeline-active {
  animation: timelineReveal 0.8s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

/* Coffee cup dot */
.timeline-node-dot {
  font-size: 1.75rem;
  line-height: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.22s, filter 0.22s;
  filter: grayscale(0.45) brightness(0.75);
  position: relative;
  z-index: 2;
}

.timeline-node:hover .timeline-node-dot {
  transform: scale(1.2) translateY(-2px);
  filter: grayscale(0) brightness(1);
}

.timeline-node.is-selected .timeline-node-dot {
  transform: scale(1.35) translateY(-3px);
  filter: grayscale(0) brightness(1.1) drop-shadow(0 0 8px rgba(224, 217, 207, 0.9));
  animation: cupGlow 1.8s ease-in-out infinite;
}

@keyframes cupGlow {
  0%, 100% { filter: grayscale(0) brightness(1.1) drop-shadow(0 0 6px rgba(55, 36, 20, 0.8)); }
  50%       { filter: grayscale(0) brightness(1.2) drop-shadow(0 0 14px rgba(55, 36, 20, 1)); }
}

/* Date label */
.timeline-node-date {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #E0D9CF;
  text-align: center;
  white-space: nowrap;
  transition: color 0.2s;
  line-height: 1.2;
}

.timeline-node:hover .timeline-node-date,
.timeline-node.is-selected .timeline-node-date {
  color: #E0D9CF;
}

/* Expandable detail panel */
.timeline-detail-wrap {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.3s ease;
  margin-top: 0.5rem;
  padding: 0 1rem;
}

.timeline-detail-wrap.is-open {
  max-height: 420px;
  opacity: 1;
}

.timeline-detail-clip {
  padding: 0.5rem 0 1rem;
}

.timeline-detail {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(224, 217, 207, 0.35);
  border-left: 3px solid #E0D9CF;
  border-radius: 16px;
  padding: 1.4rem 1.75rem;
  animation: fadeInDetail 0.35s cubic-bezier(0.34, 1.2, 0.64, 1);
  box-shadow:
    0 0 0 1px rgba(224, 217, 207, 0.15),
    0 0 24px rgba(224, 217, 207, 0.2),
    0 0 60px rgba(224, 217, 207, 0.1),
    inset 0 0 30px rgba(224, 217, 207, 0.04);
}

@keyframes fadeInDetail {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.timeline-detail .timeline-year {
  display: inline-block;
  margin-bottom: 0.65rem;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #E0D9CF;
}

.timeline-detail h3 {
  color: #E0D9CF;
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 0.6rem;
  line-height: 1.3;
}

.timeline-detail p {
  color: rgba(224, 217, 207, 0.72);
  line-height: 1.7;
  font-size: 0.92rem;
  margin: 0;
}

/* ──────────────────────────────────────────────────────────────────────────── */

.timeline-title {
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 1;
  margin-top: 20px;
  color: #E0D9CF;
}

.horizontal-timeline {
  position: relative;
  display: flex;
  gap: 42px;
  overflow-x: auto;
  padding: 100px 7vw 50px;
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
}

.horizontal-timeline::-webkit-scrollbar {
  display: none;
}

/* Main timeline line */
.horizontal-timeline::before {
  content: "";
  position: absolute;
  top: 115px;
  left: 7vw;
  right: 7vw;
  height: 2px;
  background: linear-gradient(
    to right,
    rgba(255,255,255,0.08),
    #E0D9CF,
    rgba(255,255,255,0.08)
  );
  z-index: 0;
}

.timeline-item {
  position: relative;
  min-width: 320px;
  max-width: 320px;
  flex-shrink: 0;
  scroll-snap-align: center;

  opacity: 0;
  transform: translateY(40px);
}

.timeline-active {
  animation: timelineReveal 0.8s ease forwards;
}

/* DOT */
.timeline-dot {
  position: absolute;
  top: -56px;
  left: 28px;

  width: 30px;
  height: 30px;

  border-radius: 50%;
  background: #E0D9CF;

  border: 2px solid #372414;

  display: flex;
  align-items: center;
  justify-content: center;

  z-index: 3;
}

.timeline-dot-glow {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: white;

  box-shadow:
    0 0 12px rgba(255,255,255,0.95),
    0 0 28px rgba(224, 217, 207, 0.95),
    0 0 55px rgba(224, 217, 207, 0.7);

  animation: pulseGlow 2s infinite ease-in-out;
}

/* CARD */
.timeline-content {
  position: relative;
  z-index: 2;

  background: rgba(255,255,255,0.04);

  border: 1px solid rgba(255,255,255,0.08);

  backdrop-filter: blur(14px);

  border-radius: 28px;

  padding: 28px;

  min-height: 250px;

  transition: all 0.35s ease;
}

.timeline-content:hover {
  transform: translateY(-8px);

  border-color: rgba(224, 217, 207, 0.5);

  box-shadow: 0 18px 50px rgba(0,0,0,0.3);
}

.timeline-year {
  display: inline-block;

  margin-bottom: 14px;

  font-size: 0.8rem;

  letter-spacing: 0.18em;

  text-transform: uppercase;

  color: #E0D9CF;
}

.timeline-content h3 {
  color: #E0D9CF;

  font-size: 1.45rem;

  margin-bottom: 14px;

  line-height: 1.2;
}

.timeline-content p {
  color: rgba(255,255,255,0.72);

  line-height: 1.7;

  font-size: 0.98rem;
}

@keyframes pulseGlow {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.35);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes timelineReveal {
  0%   { opacity: 0; transform: translateY(14px) scale(0.93); }
  100% { opacity: 1; transform: translateY(0)    scale(1); }
}

/* MOBILE */

@media (max-width: 768px) {
  .horizontal-timeline {
    gap: 28px;
  }

  .timeline-item {
    min-width: 270px;
    max-width: 270px;
  }

  .timeline-content {
    min-height: 270px;
    padding: 22px;
  }

  .timeline-content h3 {
    font-size: 1.2rem;
  }
}

/* Saved Cafés Grid */
.saved-cafes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1rem;
  margin-top: 1.5rem;
}

.saved-cafe-card {
  background: #1C2E52;
  border: 1px solid #2E5482;
  border-radius: 12px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  transition: border-color 0.2s;
}

.saved-cafe-card:hover {
  border-color: #E0D9CF;
}

.saved-cafe-name {
  font-size: 1rem;
  font-weight: 700;
  color: #E0D9CF;
  margin: 0;
}

.saved-cafe-neighborhood {
  font-size: 0.8rem;
  color: #E0D9CF;
  margin: 0;
}

.saved-cafe-borough {
  font-size: 0.75rem;
  color: #E0D9CF;
  background: #1C2E52;
  border: 1px solid #2E5482;
  border-radius: 20px;
  padding: 0.15rem 0.6rem;
  display: inline-block;
  width: fit-content;
  margin: 0.2rem 0;
}

.saved-cafe-directions {
  font-size: 0.8rem;
  color: #E0D9CF;
  text-decoration: none;
  margin-top: 0.25rem;
  transition: color 0.2s;
}

.saved-cafe-directions:hover {
  color: #E0D9CF;
}

.saved-cafe-remove {
  margin-top: auto;
  padding-top: 0.75rem;
  background: transparent;
  border: none;
  color: #2E5482;
  font-size: 0.78rem;
  cursor: pointer;
  text-align: left;
  transition: color 0.2s;
}

.saved-cafe-remove:hover {
  color: #c0392b;
}

.empty-saved {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 0.5rem;
}

.empty-saved-cta {
  background: #E0D9CF;
  color: #1C2E52;
  border: solid 2px #2E5482;
  padding: 0.6rem 1.25rem;
  border-radius: 10px;
  font-size: 0.9rem;
  cursor: pointer;
  width: fit-content;
  transition: all 0.3s;
  outline: none;
  user-select: none;
  box-shadow:
    inset 0px -6px 18px -6px rgba(15, 26, 46, 0),
    inset rgba(224, 217, 207, 0.8) -1px -1px 6px 0px,
    inset 12px 0px 12px -6px rgba(15, 26, 46, 0),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 0),
    rgba(46, 84, 130, 0.6) -1px -1px 6px 0px,
    0 0 12px rgba(224, 217, 207, 0.18);
}

.empty-saved-cta:hover {
  background: #E0D9CF;
  transform: translateY(-2px);
  box-shadow:
    rgba(46, 84, 130, 0.45) -1px -1px 6px 0px,
    0 6px 20px rgba(46, 84, 130, 0.18),
    0 0 18px rgba(224, 217, 207, 0.3),
    inset 0px -2px 6px -1px rgba(15, 26, 46, 0.12);
}

.empty-saved-cta:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(15, 26, 46, 1),
    inset 0px 12px 12px -6px rgba(15, 26, 46, 1),
    inset 12px 0px 12px -6px rgba(15, 26, 46, 1),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 1),
    -1px -1px 6px 0px rgba(46, 84, 130, 0.8);
}

/* Dashboard — Saved Lists */
.dash-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 100px 2rem 4rem;
}

.dash-layout {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 1.5rem;
  align-items: start;
  margin-top: 1.5rem;
}

.dash-lists {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.dash-list {
  background: #1C2E52;
  border: 1px solid #2E5482;
  border-radius: 14px;
  overflow: hidden;
  transition: border-color 0.2s;
}

.dash-list:hover,
.dash-list.is-open {
  border-color: #E0D9CF;
}

.dash-list-head {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 0.9rem 1rem;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
}

/* cover image slot (photos TBD) */
.dash-list-thumb {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  background: #1C2E52;
  border: 1px dashed #372414;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #E0D9CF;
  flex-shrink: 0;
}

.dash-list-thumb small {
  font-size: 0.55rem;
  letter-spacing: 0.08em;
}

.dash-list-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  min-width: 0;
}

.dash-list-name {
  color: #E0D9CF;
  font-weight: 700;
  font-size: 1rem;
}

.dash-list-count {
  color: #E0D9CF;
  font-size: 0.78rem;
}

.dash-list-chevron {
  color: #E0D9CF;
  font-size: 1.1rem;
  transition: transform 0.25s;
}

.dash-list.is-open .dash-list-chevron {
  transform: rotate(180deg);
}

.dash-list-body {
  padding: 0 1rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  /* favorites stays open — once it gets long it scrolls instead of collapsing */
  max-height: 340px;
  overflow-y: auto;
}

/* ── Permission blur wall ──────────────────────────────────────────────────── */
.dash-wrapper {
  position: relative;
}

.dash-content--blurred {
  filter: blur(10px) brightness(0.35);
  pointer-events: none;
  user-select: none;
}

.dash-perm-wall {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.5rem;
  pointer-events: all;
}

.dash-perm-card {
  width: 100%;
  max-width: 460px;
  background: #0F1A2E;
  border: 1px solid rgba(224, 217, 207, 0.35);
  border-radius: 20px;
  padding: 2.25rem 2rem;
  text-align: center;
  box-shadow:
    0 32px 80px rgba(0, 0, 0, 0.75),
    0 0 0 1px rgba(224, 217, 207, 0.08),
    0 0 60px rgba(224, 217, 207, 0.06);
  animation: permCardIn 0.38s cubic-bezier(0.34, 1.28, 0.64, 1);
}

@keyframes permCardIn {
  from { opacity: 0; transform: scale(0.92) translateY(20px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}

.dash-perm-emoji {
  font-size: 2.4rem;
  display: block;
  margin-bottom: 0.85rem;
}

.dash-perm-title {
  color: #E0D9CF;
  font-size: 1.25rem;
  font-weight: 800;
  margin: 0 0 0.75rem;
  line-height: 1.3;
}

.dash-perm-body {
  color: rgba(224, 217, 207, 0.78);
  font-size: 0.875rem;
  line-height: 1.65;
  margin: 0 0 0.75rem;
}

.dash-perm-reassure {
  color: #2E5482;
  font-size: 0.8rem;
  font-style: italic;
  line-height: 1.55;
  margin: 0 0 1.5rem;
}

.dash-perm-actions {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.dash-perm-btn {
  width: 100%;
  padding: 0.8rem;
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s;
  outline: none;
  user-select: none;
}

.dash-perm-btn--primary {
  background: #E0D9CF;
  color: #1C2E52;
  border: 2px solid #2E5482;
  box-shadow:
    inset rgba(224, 217, 207, 0.8) -1px -1px 6px 0px,
    rgba(46, 84, 130, 0.6) -1px -1px 6px 0px,
    0 0 14px rgba(224, 217, 207, 0.2);
}

.dash-perm-btn--primary:hover {
  background: #E0D9CF;
  transform: translateY(-2px);
  box-shadow:
    rgba(46, 84, 130, 0.45) -1px -1px 6px 0px,
    0 6px 20px rgba(46, 84, 130, 0.18),
    0 0 22px rgba(224, 217, 207, 0.32),
    inset 0px -2px 6px -1px rgba(15, 26, 46, 0.12);
}

.dash-perm-btn--primary:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(15, 26, 46, 1),
    inset 0px 12px 12px -6px rgba(15, 26, 46, 1),
    inset 12px 0px 12px -6px rgba(15, 26, 46, 1),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 1),
    -1px -1px 6px 0px rgba(46, 84, 130, 0.8);
}

.dash-perm-btn--ghost {
  background: transparent;
  color: #2E5482;
  border: 1px solid #1C2E52;
}

.dash-perm-btn--ghost:hover {
  background: rgba(224, 217, 207, 0.04);
  color: #E0D9CF;
  border-color: #2E5482;
}

/* ── Café row — column layout with personal note ───────────────────────────── */
.dash-cafe-row {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: #0F1A2E;
  border: 1px solid #1C2E52;
  border-radius: 10px;
  padding: 0.6rem 0.75rem 0;
  transition: border-color 0.2s;
}

.dash-cafe-row:focus-within {
  border-color: #2E5482;
}

.dash-cafe-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  padding-bottom: 0.6rem;
}

.dash-cafe-text {
  min-width: 0;
}

.dash-cafe-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.dash-cafe-actions .saved-cafe-remove {
  margin: 0;
  padding: 0;
}

/* Personal note textarea */
.dash-cafe-note {
  width: 100%;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-top: 1px solid #1C2E52;
  color: #E0D9CF;
  font-size: 0.78rem;
  font-family: inherit;
  line-height: 1.55;
  resize: none;
  outline: none;
  padding: 0.5rem 0 0.55rem;
  transition: border-color 0.2s;
}

.dash-cafe-note::placeholder {
  color: #2E5482;
  font-style: italic;
}

.dash-cafe-note:focus {
  border-color: #2E5482;
}

/* Collapsed note row — preview text only */
.dash-note-collapsed {
  border-top: 1px solid #1C2E52;
  padding: 0.45rem 0 0.5rem;
}

.dash-note-preview {
  font-size: 0.8rem;
  color: #E0D9CF;
  font-style: italic;
  line-height: 1.45;
  margin: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dash-note-saved-flash {
  color: #E0D9CF;
  font-style: normal;
  font-weight: 700;
}

/* 📝 note toggle button — sits in dash-cafe-actions, transparent */
.dash-note-edit-btn {
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
  padding: 0.1rem 0.15rem;
  opacity: 0.45;
  transition: opacity 0.18s, transform 0.18s;
  display: flex;
  align-items: center;
}

.dash-note-edit-btn:hover {
  opacity: 1;
  transform: scale(1.15);
}

/* Slightly brighter when a note already exists */
.dash-note-edit-btn.has-note {
  opacity: 0.8;
}

/* Save note button */
.dash-note-save {
  align-self: flex-end;
  margin-top: 0.3rem;
  margin-bottom: 0.4rem;
  padding: 0.32rem 0.9rem;
  background: #E0D9CF;
  color: #1C2E52;
  border: 1.5px solid #2E5482;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow:
    inset rgba(224, 217, 207, 0.6) -1px -1px 5px 0px,
    0 0 10px rgba(224, 217, 207, 0.15);
}

.dash-note-save:hover {
  background: #E0D9CF;
  transform: translateY(-1px);
  box-shadow:
    0 4px 14px rgba(46, 84, 130, 0.2),
    0 0 18px rgba(224, 217, 207, 0.28);
}

.dash-note-save--done {
  background: rgba(224, 217, 207, 0.15);
  color: #E0D9CF;
  border-color: rgba(224, 217, 207, 0.4);
  box-shadow: 0 0 12px rgba(224, 217, 207, 0.3);
}

.dash-list-empty {
  color: #E0D9CF;
  font-size: 0.85rem;
  margin: 0.25rem 0 0;
}

.dash-list-delete {
  background: transparent;
  border: none;
  color: #2E5482;
  font-size: 0.75rem;
  cursor: pointer;
  text-align: left;
  padding: 0;
  transition: color 0.2s;
}

.dash-list-delete:hover {
  color: #c0392b;
}

.dash-new-list {
  display: flex;
  gap: 0.6rem;
}

.dash-new-list input {
  flex: 1;
  background: #1C2E52;
  border: 1px dashed #372414;
  border-radius: 10px;
  color: #E0D9CF;
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
  outline: none;
  transition: border-color 0.2s;
}

.dash-new-list input:focus {
  border-color: #E0D9CF;
}

.dash-new-list button {
  background: #E0D9CF;
  color: #1C2E52;
  border: solid 2px #2E5482;
  border-radius: 10px;
  padding: 0 1.1rem;
  cursor: pointer;
  transition: all 0.3s;
  outline: none;
  user-select: none;
  box-shadow:
    inset 0px -6px 18px -6px rgba(15, 26, 46, 0),
    inset rgba(224, 217, 207, 0.8) -1px -1px 6px 0px,
    inset 12px 0px 12px -6px rgba(15, 26, 46, 0),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 0),
    rgba(46, 84, 130, 0.6) -1px -1px 6px 0px,
    0 0 12px rgba(224, 217, 207, 0.18);
}

.dash-new-list button:hover {
  background: #E0D9CF;
  transform: translateY(-2px);
  box-shadow:
    rgba(46, 84, 130, 0.45) -1px -1px 6px 0px,
    0 6px 20px rgba(46, 84, 130, 0.18),
    0 0 18px rgba(224, 217, 207, 0.3),
    inset 0px -2px 6px -1px rgba(15, 26, 46, 0.12);
}

.dash-new-list button:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(15, 26, 46, 1),
    inset 0px 12px 12px -6px rgba(15, 26, 46, 1),
    inset 12px 0px 12px -6px rgba(15, 26, 46, 1),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 1),
    -1px -1px 6px 0px rgba(46, 84, 130, 0.8);
}

.dash-map {
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #2E5482;
  height: 640px; /* fixed height so the map always fills the whole box */
}

.dash-map-empty {
  padding: 2rem;
}

.settings-placeholder {
  background: #1C2E52;
  border: 1px dashed #372414;
  border-radius: 12px;
  padding: 1.25rem;
  color: #E0D9CF;
  font-size: 0.9rem;
}

@media (max-width: 900px) {
  .dash-layout {
    grid-template-columns: 1fr;
  }
}

/* For Café Owners */
.owners-content {
  max-width: 1100px;
  margin: 0 auto;
  padding: 100px 2rem 4rem;
}

/* intro paragraph on the left, tagline on the right */
.owners-intro-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 3rem;
}

.owners-tagline {
  color: #E0D9CF;
  font-size: 0.9rem;
  letter-spacing: 0.04em;
  line-height: 1.9;
  margin: 0;
  text-align: right;
  flex-shrink: 0;
}

@media (max-width: 860px) {
  .owners-intro-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .owners-tagline {
    text-align: left;
  }
}

.owners-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin-top: 2rem;
  /* both panels stretch to the same height so the row stays even */
}

.owners-why {
  background: #E0D9CF;
  border: 2px solid #372414;
  box-shadow: 0 0 0 1px rgba(55,36,20,0.15), 0 4px 20px rgba(55,36,20,0.12);
  border-radius: 16px;
  padding: 2rem;
  display: flex;
  flex-direction: column;
}

.owners-why h2,
.owner-form h2 {
  color: #372414;
  font-size: 1.35rem;
  margin: 0 0 1.25rem;
  font-family: 'Instrument Serif', serif;
}

.owners-why ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.owners-why li {
  color: #372414;
  font-size: 0.95rem;
  display: flex;
  gap: 0.6rem;
  line-height: 1.5;
  font-family: 'Instrument Serif', serif;
}

.owners-why-arrow {
  color: #372414;
}

.owners-why-footnote {
  margin-top: auto;
  padding-top: 1.75rem;
  color: rgba(55, 36, 20, 0.65);
  font-size: 0.9rem;
}

.owners-why-footnote a {
  color: #372414;
  font-weight: 600;
}

.owner-form {
  background: #E0D9CF;
  border: 2px solid #372414;
  box-shadow: 0 0 0 1px rgba(55,36,20,0.15), 0 4px 20px rgba(55,36,20,0.12);
  border-radius: 16px;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.owner-field-label {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #372414;
  font-family: 'Instrument Serif', serif;
  margin-bottom: -0.45rem; /* tighten gap between label and its input */
}

.owner-req {
  color: #E0D9CF;
}

.owner-form input,
.owner-form textarea {
  background: rgba(255,255,255,0.55);
  border: 1px solid rgba(55, 36, 20, 0.35);
  border-radius: 8px;
  color: #372414;
  font-family: 'Instrument Serif', serif;
  font-size: 14px;
  padding: 13px 15px;
  outline: none;
  transition: border-color 0.2s;
  resize: vertical;
}

.owner-form input::placeholder,
.owner-form textarea::placeholder {
  color: rgba(55, 36, 20, 0.45);
}

.owner-form input:focus,
.owner-form textarea:focus {
  border-color: #E0D9CF;
}

.owner-form button {
  background: #372414;
  color: #E0D9CF;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 14px;
  border: 1.5px solid #1C2E52;
  border-radius: 999px;
  cursor: pointer;
  transition: border-color 0.3s, box-shadow 0.3s, color 0.3s, transform 0.15s, background 0.3s;
  outline: none;
  user-select: none;
  box-shadow: 0 0 14px rgba(55, 36, 20, 0.2);
}

.owner-form button:hover {
  border-color: #E0D9CF;
  box-shadow: 0 0 20px rgba(55, 36, 20, 0.35), 0 0 6px rgba(55, 36, 20, 0.2);
  transform: translateY(-1px);
}

.owner-form button:active {
  transform: translateY(0);
  box-shadow: 0 0 10px rgba(224, 217, 207, 0.15);
}

.owner-form button:disabled {
  opacity: 0.5;
  cursor: wait;
}

.form-status {
  font-size: 0.85rem;
  line-height: 1.5;
  margin: 0;
}

.form-status--ok {
  color: #8fbf8f;
}

.form-status--err {
  color: #d98a80;
}

/* beige thank-you card that replaces the form after sending */
.owner-form-success {
  background: #E0D9CF;
  border-radius: 16px;
  padding: 2rem;
  min-height: 420px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  text-align: center;
  animation: pageFade 0.4s ease-out both;
}

.owner-form-success-cup {
  font-size: 2.5rem;
}

.owner-form-success p {
  color: #1C2E52;
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.6;
  margin: 0;
  max-width: 380px;
}

.owner-form-success button {
  background: #E0D9CF;
  color: #1C2E52;
  border: solid 2px #2E5482;
  font-size: 0.85rem;
  padding: 0.5rem 1.25rem;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
  outline: none;
  user-select: none;
  box-shadow:
    inset 0px -6px 18px -6px rgba(15, 26, 46, 0),
    inset rgba(224, 217, 207, 0.5) -1px -1px 6px 0px,
    inset 12px 0px 12px -6px rgba(15, 26, 46, 0),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 0),
    rgba(46, 84, 130, 0.35) -1px -1px 6px 0px,
    0 0 10px rgba(224, 217, 207, 0.14);
}

.owner-form-success button:hover {
  background: #E0D9CF;
  transform: translateY(-2px);
  box-shadow:
    rgba(46, 84, 130, 0.3) -1px -1px 6px 0px,
    0 5px 14px rgba(46, 84, 130, 0.12),
    0 0 14px rgba(224, 217, 207, 0.2),
    inset 0px -2px 5px -1px rgba(15, 26, 46, 0.1);
}

.owner-form-success button:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(15, 26, 46, 1),
    inset 0px 12px 12px -6px rgba(15, 26, 46, 1),
    inset 12px 0px 12px -6px rgba(15, 26, 46, 1),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 1),
    -1px -1px 6px 0px rgba(46, 84, 130, 0.5);
}

@media (max-width: 860px) {
  .owners-layout {
    grid-template-columns: 1fr;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   GLOBAL RESPONSIVE ADDITIONS
   Breakpoints: 1024 (tablet), 768 (mobile), 480 (small phone)
   All additions are appended here to avoid touching existing rules.
═══════════════════════════════════════════════════════════════════════════ */

/* ── Shared page title scaling ───────────────────────────────────────────── */
@media (max-width: 768px) {
  .page-title {
    font-size: 2rem;
  }
  .page-badge {
    font-size: 0.78rem;
    padding: 0.4rem 1rem;
  }
  .page-body {
    font-size: 0.95rem;
  }
}

@media (max-width: 480px) {
  .page-title {
    font-size: 1.65rem;
  }
}

/* ── Team blur gate — lifts when "Meet the Team" button is clicked ───────── */
.team-blur-gate {
  filter: blur(10px) brightness(0.55);
  opacity: 0.5;
  pointer-events: auto;
  user-select: none;
  transition: filter 0.6s ease, opacity 0.6s ease;
}

.team-blur-gate:hover {
  filter: blur(5px) brightness(0.75);
  opacity: 0.7;
  transition: filter 0.4s ease, opacity 0.4s ease;
}

/* ── Blur gate — applied to scroll-hint + timeline before user clicks ───── */
.about-blur-gate {
  filter: blur(7px);
  opacity: 0.55;
  /* pointer-events off so nothing in the blurred area is interactive... */
  pointer-events: none;
  user-select: none;
  transition: filter 0.7s ease, opacity 0.7s ease;
}

/* Section snaps clear once the class is removed */
.timeline-section {
  transition: filter 0.7s ease, opacity 0.7s ease;
}

/* ── About intro ─────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .about-intro {
    padding: 100px 1.5rem 1.25rem;
  }
  .about-headline {
    font-size: clamp(1.9rem, 6vw, 2.8rem);
    margin-bottom: 1.75rem;
  }
  .about-hero {
    gap: 1.5rem;
  }
  .about-img--hero {
    height: 260px;
  }
  .about-scroll-hint {
    margin-top: 0.75rem;
  }
}

@media (max-width: 480px) {
  .about-intro {
    padding: 90px 1rem 1rem;
  }
  .about-headline {
    font-size: clamp(1.65rem, 7vw, 2.2rem);
    margin-bottom: 1.25rem;
  }
  .about-img--hero {
    height: 210px;
  }
}

/* ── Timeline (interactive track) ───────────────────────────────────────── */
@media (max-width: 768px) {
  .timeline-section {
    padding: 8px 0 60px;
  }
  .timeline-track-wrap {
    padding: 20px 3vw 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .timeline-track-wrap::-webkit-scrollbar {
    display: none;
  }
  .timeline-track {
    min-width: 560px;
    padding: 1rem 0.75rem 0.5rem;
  }
  .timeline-detail {
    padding: 1rem 1.25rem;
    margin: 32px auto 6px;
  }
  .timeline-detail h3 {
    font-size: 1.05rem;
  }
  .timeline-node-date {
    font-size: 0.58rem;
  }
  .timeline-node-dot {
    font-size: 1.45rem;
  }
  .timeline-node-icon-wrap {
    width: 34px;
    height: 34px;
  }
}

@media (max-width: 480px) {
  .timeline-track {
    min-width: 480px;
  }
}

/* ── Team section (ed-section) ───────────────────────────────────────────── */
@media (max-width: 900px) {
  .ed-section {
    flex-direction: column;
    min-height: auto;
  }
  .ed-featured {
    padding: 5rem 2rem 2.5rem;
    border-right: none;
    border-bottom: 1px solid #1C2E52;
  }
  .ed-featured-top {
    top: 1.5rem;
    left: 2rem;
  }
  .ed-list {
    padding: 2rem 1.5rem 3rem;
    overflow-y: visible;
    justify-content: flex-start;
    gap: 0;
  }
  .kraft-receipt {
    max-width: 420px;
  }
}

@media (max-width: 480px) {
  .ed-featured {
    padding: 4rem 1rem 2rem;
  }
  .ed-featured-top {
    left: 1rem;
  }
  .kraft-receipt {
    padding: 2rem 1.5rem;
    max-width: 100%;
  }
  .ed-list {
    padding: 1.5rem 1rem 2.5rem;
  }
  .ed-list-name {
    font-size: 0.85rem;
  }
  .ed-list-role {
    font-size: 0.7rem;
  }
}

/* ── Dashboard ───────────────────────────────────────────────────────────── */

/* ── Tablet (≤900px): already stacks to 1 column via existing rule.
   Add centering + breathing room here. ─────────────────────────────────── */
@media (max-width: 900px) {
  .dash-content {
    text-align: center;
  }
  /* Keep badge centered but don't stretch it */
  .dash-content > .page-badge {
    display: inline-block;
  }
  /* Center the section title */
  .dash-content > .page-title {
    text-align: center;
  }
  /* Let lists panel fill the full width gracefully */
  .dash-layout {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  /* Align list-head text to left inside the centered container */
  .dash-list-head {
    text-align: left;
  }
  /* Keep café row text left-aligned */
  .dash-cafe-top,
  .dash-cafe-text,
  .dash-cafe-row {
    text-align: left;
  }
  /* Center the empty-saved placeholder */
  .empty-saved {
    align-items: center;
    text-align: center;
  }
  /* Center new-list form */
  .dash-new-list {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .dash-content {
    padding: 100px 1.25rem 3rem;
  }
  .dash-map {
    height: 420px;
    max-width: 600px;
    margin: 0 auto;
  }
  .dash-layout {
    gap: 1.25rem;
  }
  .dash-list-body {
    max-height: 280px;
  }
  /* Slightly tighter action buttons so they don't spill */
  .dash-cafe-actions {
    gap: 0.35rem;
  }
  /* Make permission card sit comfortably */
  .dash-perm-card {
    padding: 1.75rem 1.5rem;
  }
  .dash-perm-title {
    font-size: 1.1rem;
  }
  .dash-perm-body {
    font-size: 0.82rem;
  }
}

@media (max-width: 480px) {
  .dash-content {
    padding: 90px 1rem 2.5rem;
  }
  .dash-content > .page-title {
    font-size: 1.55rem;
  }
  .dash-map {
    height: 300px;
    border-radius: 12px;
  }
  .dash-layout {
    gap: 1rem;
  }
  /* Stack new-list form vertically */
  .dash-new-list {
    flex-direction: column;
    gap: 0.5rem;
  }
  .dash-new-list input,
  .dash-new-list button {
    width: 100%;
  }
  .dash-new-list button {
    padding: 0.75rem 1rem;
  }
  /* Café row: keep name + address readable, action icons neat */
  .dash-cafe-top {
    gap: 0.5rem;
  }
  .dash-cafe-actions {
    gap: 0.25rem;
    flex-shrink: 0;
  }
  /* Slightly smaller name text so long names don't push icons off */
  .saved-cafe-name {
    font-size: 0.9rem;
  }
  .saved-cafe-neighborhood {
    font-size: 0.75rem;
  }
  /* List thumbnail slightly smaller */
  .dash-list-thumb {
    width: 44px;
    height: 44px;
  }
  /* Permission card full-width on small phones */
  .dash-perm-card {
    padding: 1.5rem 1.25rem;
    border-radius: 16px;
  }
  .dash-perm-title {
    font-size: 1rem;
  }
}

/* ── For Owners page ─────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .owners-content {
    padding: 100px 1.5rem 3rem;
  }
  .owners-intro-row {
    gap: 1.25rem;
  }
  .owners-layout {
    gap: 1rem;
    margin-top: 1.5rem;
  }
}

@media (max-width: 480px) {
  .owners-content {
    padding: 90px 1rem 2.5rem;
  }
}

/* ── Auth page ───────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .page-content--centered {
    padding: 100px 1.25rem 3rem;
    justify-content: flex-start;
    min-height: auto;
  }
  .auth-hero {
    font-size: 1.85rem;
  }
  .auth-card {
    padding: 36px 24px;
    gap: 18px;
  }
}

@media (max-width: 480px) {
  .page-content--centered {
    padding: 90px 1rem 2.5rem;
  }
  .auth-hero {
    font-size: 1.55rem;
  }
  .auth-hero-sub {
    font-size: 0.88rem;
  }
  .auth-card {
    padding: 28px 18px;
    gap: 14px;
  }
  .auth-social {
    gap: 0.55rem;
  }
}

/* Auth extras */
.auth-hero {
  text-align: center;
}

.auth-hero-sub {
  font-family: 'IAmSeventeen', Georgia, serif;
  color: #E0D9CF;
  font-size: 0.88rem;
  line-height: 1.55;
  margin: -0.5rem 0 2rem;
  max-width: 680px;
  text-align: center;
}

.auth-field-label {
  color: #E0D9CF;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  align-self: flex-start;
  margin-bottom: -8px;
}

.auth-field-hint {
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  text-transform: none;
  color: #2E5482;
  font-style: italic;
}

/* small underlined link tucked in the form's bottom-right corner */
.auth-forgot {
  color: #E0D9CF;
  font-size: 0.75rem;
  text-decoration: underline;
  align-self: flex-end;
  cursor: pointer;
  transition: color 0.2s;
}

.auth-forgot:hover {
  color: #E0D9CF;
}

.auth-divider {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 0.9rem;
  color: #E0D9CF;
  font-size: 0.8rem;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  border-top: 1px solid #2E5482;
}

.auth-social {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.auth-social button {
  width: 100%;
  background: #E0D9CF;
  color: #1C2E52;
  border: solid 2px #2E5482;
  border-radius: 10px;
  padding: 12px;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s;
  outline: none;
  user-select: none;
  box-shadow:
    inset 0px -6px 18px -6px rgba(15, 26, 46, 0),
    inset rgba(224, 217, 207, 0.8) -1px -1px 6px 0px,
    inset 12px 0px 12px -6px rgba(15, 26, 46, 0),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 0),
    rgba(46, 84, 130, 0.6) -1px -1px 6px 0px,
    0 0 12px rgba(224, 217, 207, 0.18);
}

.auth-social button:hover {
  background: #E0D9CF;
  transform: translateY(-2px);
  box-shadow:
    rgba(46, 84, 130, 0.45) -1px -1px 6px 0px,
    0 6px 20px rgba(46, 84, 130, 0.18),
    0 0 18px rgba(224, 217, 207, 0.3),
    inset 0px -2px 6px -1px rgba(15, 26, 46, 0.12);
}

.auth-social button:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(15, 26, 46, 1),
    inset 0px 12px 12px -6px rgba(15, 26, 46, 1),
    inset 12px 0px 12px -6px rgba(15, 26, 46, 1),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 1),
    -1px -1px 6px 0px rgba(46, 84, 130, 0.8);
}

.auth-switch {
  font-size: 13px;
  color: #E0D9CF;
}

.auth-switch a {
  color: #E0D9CF;
  font-weight: 600;
  text-decoration: none;
}

.auth-switch a:hover {
  text-decoration: underline;
}

/* Settings page */
.settings-card {
  background: #1C2E52;
  border: 1px solid #2E5482;
  border-radius: 16px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  max-width: 420px;
}

.settings-card input {
  background: #1C2E52;
  border: 1px solid #2E5482;
  border-radius: 8px;
  color: #E0D9CF;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  padding: 13px 15px;
  outline: none;
  transition: border-color 0.2s;
}

.settings-card input:focus {
  border-color: #E0D9CF;
}

.settings-card button {
  background: #E0D9CF;
  color: #1C2E52;
  font-weight: 700;
  font-size: 14px;
  padding: 12px 1.5rem;
  border: solid 2px #2E5482;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.3s;
  outline: none;
  user-select: none;
  width: fit-content;
  box-shadow:
    inset 0px -6px 18px -6px rgba(15, 26, 46, 0),
    inset rgba(224, 217, 207, 0.8) -1px -1px 6px 0px,
    inset 12px 0px 12px -6px rgba(15, 26, 46, 0),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 0),
    rgba(46, 84, 130, 0.6) -1px -1px 6px 0px,
    0 0 12px rgba(224, 217, 207, 0.18);
}

.settings-card button:hover {
  background: #E0D9CF;
  transform: translateY(-2px);
  box-shadow:
    rgba(46, 84, 130, 0.45) -1px -1px 6px 0px,
    0 6px 20px rgba(46, 84, 130, 0.18),
    0 0 18px rgba(224, 217, 207, 0.3),
    inset 0px -2px 6px -1px rgba(15, 26, 46, 0.12);
}

.settings-card button:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(15, 26, 46, 1),
    inset 0px 12px 12px -6px rgba(15, 26, 46, 1),
    inset 12px 0px 12px -6px rgba(15, 26, 46, 1),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 1),
    -1px -1px 6px 0px rgba(46, 84, 130, 0.8);
}

.settings-logout {
  margin-top: 2rem;
  background: #E0D9CF;
  color: #1C2E52;
  border: solid 2px #2E5482;
  padding: 0.6rem 1.25rem;
  border-radius: 10px;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s;
  outline: none;
  user-select: none;
  box-shadow:
    inset 0px -6px 18px -6px rgba(15, 26, 46, 0),
    inset rgba(224, 217, 207, 0.8) -1px -1px 6px 0px,
    inset 12px 0px 12px -6px rgba(15, 26, 46, 0),
    inset -12px 0px 12px -6px rgba(15, 26, 46, 0),
    rgba(46, 84, 130, 0.6) -1px -1px 6px 0px,
    0 0 12px rgba(224, 217, 207, 0.18);
}

.settings-logout:hover {
  background: #f0c0b0;
  color: #8b1a1a;
  border-color: #8b2020;
  transform: translateY(-2px);
  box-shadow:
    rgba(139, 26, 26, 0.4) -1px -1px 6px 0px,
    0 6px 18px rgba(139, 26, 26, 0.15),
    0 0 16px rgba(200, 80, 80, 0.25),
    inset 0px -2px 5px -1px rgba(80, 10, 10, 0.12);
}

.settings-logout:active {
  transform: translateY(1px);
  box-shadow:
    inset 0px -12px 12px -6px rgba(80, 10, 10, 1),
    inset 0px 12px 12px -6px rgba(80, 10, 10, 1),
    inset 12px 0px 12px -6px rgba(80, 10, 10, 1),
    inset -12px 0px 12px -6px rgba(80, 10, 10, 1),
    -1px -1px 6px 0px rgba(139, 26, 26, 0.5);
}


/* ── Timeline bear icon node ─────────────────────────────────────────────── */
.timeline-node-icon-wrap {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #1C2E52;
  border: 2px solid #372414;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  transition: transform 0.22s, border-color 0.22s, box-shadow 0.22s;
  color: #2E5482;
  box-shadow: none;
}

.timeline-node:hover .timeline-node-icon-wrap {
  transform: scale(1.15) translateY(-3px);
  border-color: #372414;
  color: #E0D9CF;
  box-shadow: 0 0 14px rgba(55, 36, 20, 0.6);
}

.timeline-node.is-selected .timeline-node-icon-wrap {
  transform: scale(1.25) translateY(-4px);
  border-color: #372414;
  color: #E0D9CF;
  background: #372414;
  box-shadow: 0 0 18px rgba(55, 36, 20, 0.8), 0 0 36px rgba(55, 36, 20, 0.4);
  animation: nodeGlow 1.8s ease-in-out infinite;
}

@keyframes nodeGlow {
  0%, 100% { box-shadow: 0 0 14px rgba(224, 217, 207,0.7), 0 0 28px rgba(224, 217, 207,0.3); }
  50%       { box-shadow: 0 0 24px rgba(224, 217, 207,1),   0 0 48px rgba(224, 217, 207,0.5); }
}

/* ── Timeline detail card (class used in JSX: timeline-detail-box) ──────── */
.timeline-detail-box {
  margin: 1.5rem 1rem 0;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(224, 217, 207, 0.35);
  box-shadow:
    0 0 0 1px rgba(224, 217, 207, 0.1),
    0 0 28px rgba(224, 217, 207, 0.18),
    0 0 60px rgba(224, 217, 207, 0.08),
    inset 0 0 30px rgba(224, 217, 207, 0.03);
  overflow: hidden;
}

.timeline-detail-content {
  padding: 1.4rem 1.75rem;
  animation: fadeInDetail 0.45s cubic-bezier(0.25, 0.8, 0.25, 1) both;
}

.timeline-detail-content .timeline-year {
  display: inline-block;
  margin-bottom: 0.55rem;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #E0D9CF;
}

.timeline-detail-content h3 {
  color: #E0D9CF;
  font-size: 1.2rem;
  font-weight: 700;
  margin: 0 0 0.6rem;
  line-height: 1.3;
}

.timeline-detail-content p {
  color: rgba(224, 217, 207, 0.72);
  line-height: 1.7;
  font-size: 0.92rem;
  margin: 0;
}

/* ── Meet the Team CTA ────────────────────────────────────────────────────── */
.timeline-team-cta-wrap {
  padding: 0 1rem;
  margin-top: 1.75rem;
  margin-bottom: 0.5rem;
  display: flex;
  justify-content: center;
}

.timeline-meet-btn,
.timeline-team-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: #1C2E52;
  border: 1.5px solid #372414;
  color: #E0D9CF;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.65rem 1.75rem;
  border-radius: 999px;
  cursor: pointer;
  transition: border-color 0.3s, box-shadow 0.3s, color 0.3s;
  box-shadow: 0 0 14px rgba(224, 217, 207, 0.1);
  outline: none;
  user-select: none;
  animation: subtleBounce 3s ease-in-out infinite;
}

.timeline-meet-btn:hover,
.timeline-team-cta-btn:hover {
  border-color: #E0D9CF;
  box-shadow: 0 0 20px rgba(55, 36, 20, 0.35), 0 0 6px rgba(55, 36, 20, 0.2);
  transform: translateY(-1px);
}

.timeline-meet-btn:active,
.timeline-team-cta-btn:active {
  transform: translateY(0);
  box-shadow: 0 0 10px rgba(224, 217, 207, 0.15);
}

/* Mobile adjustments for timeline detail */
@media (max-width: 768px) {
  .timeline-detail-box {
    margin: 1.25rem 0.5rem 0;
  }
  .timeline-detail-content {
    padding: 1rem 1.25rem;
  }
  .timeline-detail-content h3 {
    font-size: 1.05rem;
  }
  .timeline-node-icon-wrap {
    width: 38px;
    height: 38px;
  }
  .timeline-node-icon-wrap svg {
    width: 22px;
    height: 22px;
  }
}

/* ── Timeline bear icon node ─────────────────────────────────────────────── */
.timeline-node-icon-wrap {
  font-size: 1.75rem;
  line-height: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.22s, filter 0.22s, color 0.22s;
  color: #2E5482;
  position: relative;
  z-index: 2;
}

.timeline-node:hover .timeline-node-icon-wrap {
  transform: scale(1.2) translateY(-2px);
  color: #E0D9CF;
}

.timeline-node.is-selected .timeline-node-icon-wrap {
  transform: scale(1.35) translateY(-3px);
  color: #E0D9CF;
  filter: drop-shadow(0 0 8px rgba(55, 36, 20, 0.9));
  animation: cupGlow 1.8s ease-in-out infinite;
}
/* ═══════════════════════════════════════════════════════════
   LEGAL PAGES (Privacy & Terms)
════════════════════════════════════════════════════════════ */
.legal-page {
  min-height: 100vh;
  padding: 7rem 1.5rem 4rem;
}

.legal-container {
  max-width: 780px;
  margin: 0 auto;
}

.legal-title {
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: clamp(2rem, 5vw, 3rem);
  color: #E0D9CF;
  margin: 0.5rem 0 0.25rem;
  font-weight: 400;
}

.legal-meta {
  font-family: 'Imbue', serif;
  font-size: 0.85rem;
  color: rgba(224, 217, 207, 0.5);
  margin: 0 0 2rem;
}

.legal-intro {
  font-family: 'Imbue', serif;
  font-size: 1rem;
  color: rgba(224, 217, 207, 0.85);
  line-height: 1.75;
  margin-bottom: 2.5rem;
  border-left: 3px solid #372414;
  padding-left: 1rem;
}

.legal-section {
  margin-bottom: 2.5rem;
}

.legal-section h2 {
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: 1.25rem;
  color: #E0D9CF;
  font-weight: 400;
  margin: 0 0 0.75rem;
  border-bottom: 1px solid rgba(55, 36, 20, 0.4);
  padding-bottom: 0.4rem;
}

.legal-section h3 {
  font-family: 'Imbue', serif;
  font-size: 0.95rem;
  color: rgba(224, 217, 207, 0.75);
  font-weight: 600;
  margin: 1.25rem 0 0.4rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.legal-section p,
.legal-section li {
  font-family: 'Imbue', serif;
  font-size: 0.95rem;
  color: rgba(224, 217, 207, 0.75);
  line-height: 1.8;
  margin: 0 0 0.6rem;
}

.legal-section ul {
  padding-left: 1.4rem;
  margin: 0 0 0.75rem;
}

.legal-section li {
  margin-bottom: 0.4rem;
}

.legal-link {
  color: #E0D9CF;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s;
}

.legal-link:hover {
  color: #372414;
}

.legal-contact {
  font-family: 'Imbue', serif;
  font-size: 0.95rem;
  color: rgba(224, 217, 207, 0.75);
  line-height: 1.9;
  margin-top: 0.5rem;
}

/* ═══════════════════════════════════════════════════════════
   LEGAL PAGES v2 — Hero + Sidebar Layout
════════════════════════════════════════════════════════════ */
.legal-hero {
  background: linear-gradient(135deg, #1C2E52 0%, #0F1A2E 60%, #372414 100%);
  border-bottom: 2px solid #372414;
  padding: 7rem 2rem 3rem;
  text-align: center;
}

.legal-hero-inner {
  max-width: 720px;
  margin: 0 auto;
}

.legal-hero-title {
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  color: #E0D9CF;
  font-weight: 400;
  margin: 0.5rem 0 1rem;
}

.legal-hero-sub {
  font-family: 'Imbue', serif;
  font-size: 1.05rem;
  color: rgba(224, 217, 207, 0.7);
  line-height: 1.7;
  margin: 0 0 1.75rem;
}

.legal-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  justify-content: center;
}

.legal-chip {
  font-family: 'Imbue', serif;
  font-size: 0.78rem;
  color: rgba(224, 217, 207, 0.6);
  background: rgba(55, 36, 20, 0.2);
  border: 1px solid rgba(55, 36, 20, 0.4);
  border-radius: 999px;
  padding: 0.3rem 0.9rem;
  letter-spacing: 0.03em;
}

/* Two-column layout */
.legal-layout {
  display: flex;
  align-items: flex-start;
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 1.5rem 5rem;
  gap: 3rem;
}

/* Sticky sidebar TOC */
.legal-toc {
  width: 220px;
  flex-shrink: 0;
  position: sticky;
  top: 100px;
  background: rgba(28, 46, 82, 0.4);
  border: 1px solid rgba(55, 36, 20, 0.3);
  border-radius: 12px;
  padding: 1.25rem;
}

.legal-toc-label {
  font-family: 'Imbue', serif;
  font-size: 0.7rem;
  color: rgba(224, 217, 207, 0.4);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0 0 0.75rem;
}

.legal-toc-list {
  list-style: none;
  padding: 0;
  margin: 0 0 1.25rem;
}

.legal-toc-list li {
  margin-bottom: 0.1rem;
}

.legal-toc-link {
  font-family: 'Imbue', serif;
  font-size: 0.8rem;
  color: rgba(224, 217, 207, 0.55);
  text-decoration: none;
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  padding: 0.3rem 0.5rem;
  border-radius: 6px;
  transition: background 0.2s, color 0.2s;
  line-height: 1.4;
}

.legal-toc-link:hover {
  background: rgba(55, 36, 20, 0.2);
  color: #E0D9CF;
}

.legal-toc-num {
  font-size: 0.68rem;
  color: rgba(55, 36, 20, 0.7);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.legal-toc-contact {
  border-top: 1px solid rgba(55, 36, 20, 0.3);
  padding-top: 1rem;
  font-family: 'Imbue', serif;
  font-size: 0.78rem;
}

.legal-toc-contact p {
  color: rgba(224, 217, 207, 0.4);
  margin: 0 0 0.25rem;
}

.legal-toc-contact a {
  color: rgba(224, 217, 207, 0.65);
  text-decoration: none;
  word-break: break-all;
  transition: color 0.2s;
}

.legal-toc-contact a:hover {
  color: #E0D9CF;
}

/* Main content */
.legal-body {
  flex: 1;
  min-width: 0;
}

.legal-intro-box {
  background: rgba(55, 36, 20, 0.12);
  border-left: 3px solid #372414;
  border-radius: 0 8px 8px 0;
  padding: 1.1rem 1.4rem;
  margin-bottom: 2.5rem;
}

.legal-intro-box p {
  font-family: 'Imbue', serif;
  font-size: 0.97rem;
  color: rgba(224, 217, 207, 0.8);
  line-height: 1.8;
  margin: 0;
}

.legal-section {
  margin-bottom: 3rem;
  scroll-margin-top: 100px;
}

.legal-section-header {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 1rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid rgba(55, 36, 20, 0.35);
}

.legal-icon {
  font-size: 1.1rem;
  flex-shrink: 0;
}

.legal-section-header h2 {
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: 1.3rem;
  color: #E0D9CF;
  font-weight: 400;
  margin: 0;
}

.legal-section p,
.legal-section li {
  font-family: 'Imbue', serif;
  font-size: 0.95rem;
  color: rgba(224, 217, 207, 0.72);
  line-height: 1.85;
  margin: 0 0 0.75rem;
}

.legal-section ul {
  padding-left: 1.4rem;
  margin: 0.5rem 0 1rem;
}

.legal-section li {
  margin-bottom: 0.5rem;
}

.legal-link {
  color: #E0D9CF;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: rgba(224, 217, 207, 0.35);
  transition: color 0.2s, text-decoration-color 0.2s;
}

.legal-link:hover {
  color: #E0D9CF;
  text-decoration-color: #E0D9CF;
}

.legal-highlight {
  background: rgba(55, 36, 20, 0.15);
  border: 1px solid rgba(55, 36, 20, 0.4);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  font-family: 'Imbue', serif;
  font-size: 0.92rem;
  color: rgba(224, 217, 207, 0.8);
  line-height: 1.75;
  margin-top: 1rem;
}

.legal-card {
  background: rgba(28, 46, 82, 0.3);
  border: 1px solid rgba(55, 36, 20, 0.25);
  border-radius: 10px;
  padding: 1.25rem 1.4rem;
  margin: 1rem 0;
}

.legal-card h3 {
  font-family: 'Imbue', serif;
  font-size: 0.88rem;
  color: rgba(224, 217, 207, 0.65);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 0 0.85rem;
}

/* Provider grid */
.legal-provider-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 0.85rem;
  margin: 1rem 0;
}

.legal-provider-card {
  background: rgba(28, 46, 82, 0.35);
  border: 1px solid rgba(55, 36, 20, 0.25);
  border-radius: 10px;
  padding: 1rem 1.1rem;
}

.legal-provider-name {
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: 1rem;
  color: #E0D9CF;
  margin-bottom: 0.2rem;
}

.legal-provider-role {
  font-family: 'Imbue', serif;
  font-size: 0.72rem;
  color: rgba(55, 36, 20, 0.9);
  background: rgba(55, 36, 20, 0.15);
  border-radius: 999px;
  display: inline-block;
  padding: 0.15rem 0.6rem;
  margin-bottom: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
  color: rgba(224, 217, 207, 0.5);
}

.legal-provider-card p {
  font-size: 0.82rem !important;
  margin-bottom: 0.5rem !important;
}

.legal-provider-card a {
  font-size: 0.8rem;
}

/* Rights grid */
.legal-rights-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.85rem;
  margin: 1rem 0;
}

.legal-right-item {
  background: rgba(28, 46, 82, 0.3);
  border: 1px solid rgba(55, 36, 20, 0.25);
  border-radius: 10px;
  padding: 1rem 1.1rem;
}

.legal-right-item strong {
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: 1rem;
  color: #E0D9CF;
  display: block;
  margin-bottom: 0.4rem;
}

.legal-right-item p {
  font-size: 0.83rem !important;
  margin: 0 !important;
}

/* Contact card */
.legal-contact-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  background: rgba(28, 46, 82, 0.4);
  border: 1px solid rgba(55, 36, 20, 0.35);
  border-radius: 12px;
  padding: 1.5rem;
  margin-top: 1rem;
  font-family: 'Imbue', serif;
  font-size: 0.92rem;
  color: rgba(224, 217, 207, 0.75);
  line-height: 1.9;
}

.legal-contact-logo {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #372414;
  color: #E0D9CF;
  font-family: 'InstrumentSerif', Georgia, serif;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2px solid rgba(224, 217, 207, 0.2);
}

/* Responsive */
@media (max-width: 820px) {
  .legal-layout {
    flex-direction: column;
    padding: 2rem 1rem 4rem;
    gap: 2rem;
  }
  .legal-toc {
    width: 100%;
    position: static;
  }
  .legal-toc-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .legal-toc-link {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }
  .legal-provider-grid {
    grid-template-columns: 1fr 1fr;
  }
  .legal-rights-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 480px) {
  .legal-hero {
    padding: 6rem 1rem 2.5rem;
  }
  .legal-provider-grid,
  .legal-rights-grid {
    grid-template-columns: 1fr;
  }
  .legal-contact-card {
    flex-direction: column;
    text-align: center;
  }
}
